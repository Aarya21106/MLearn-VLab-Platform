// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum SubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED_CHECKS
}

model User {
  id             String    @id @default(cuid())
  email          String?   @unique // only faculty/admin accounts have one
  name           String?
  displayName    String? // user-editable, shown instead of `name` wherever the platform displays who someone is
  role           Role      @default(STUDENT)
  registerNumber String?   @unique // student login username, set on roster upload
  section        String?
  passwordHash   String? // set for both faculty/admin and student credentials accounts
  createdAt      DateTime  @default(now())
  lastLoginAt    DateTime?

  classroomId      String?
  classroom        Classroom?  @relation("ClassroomStudents", fields: [classroomId], references: [id])
  createdClassrooms Classroom[] @relation("ClassroomCreatedBy")

  submissions Submission[]
  events      ActivityEvent[]
}

model Classroom {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdBy   User     @relation("ClassroomCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  students User[] @relation("ClassroomStudents")
}

model Experiment {
  id               String  @id @default(cuid())
  orderIndex       Int     @unique // 1 through 12, controls sidebar order + unlock sequence
  title            String
  syllabusUnit     String
  questionMd       String  @db.Text
  manualMd         String  @db.Text
  hintsMd          String  @db.Text
  starterCode      String  @db.Text
  datasetUrl       String?
  datasetPreviewMd String? @db.Text
  autograderCode   String  @db.Text
  maxScore         Int     @default(100)
  estMinutes       Int     @default(45)

  submissions Submission[]
}

model Submission {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  experimentId     String
  experiment       Experiment @relation(fields: [experimentId], references: [id])
  code             String    @db.Text
  outputLog        String    @db.Text
  status           SubmissionStatus @default(NOT_STARTED)
  score            Int?
  autograderReport String?   @db.Text // JSON: which checks passed/failed
  timeSpentSeconds Int       @default(0)
  attemptNumber    Int       @default(1)
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?

  @@unique([userId, experimentId, attemptNumber])
}

model ActivityEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         String // "login" | "logout" | "experiment_opened" | "cell_run" | "submit"
  experimentId String?
  metadata     Json?
  createdAt    DateTime @default(now())
}
